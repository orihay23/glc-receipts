# ── Dashboard auth ────────────────────────────────────────────────────────────
# Password to log into the web UI
DASHBOARD_PASSWORD=changeme

# Random string used to sign session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace-with-random-string

# ── Xero OAuth ────────────────────────────────────────────────────────────────
# From https://developer.xero.com/app/manage
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must exactly match the Redirect URI set in your Xero app
XERO_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Organisation details (printed on receipts) ────────────────────────────────
ORG_NAME=My Nonprofit
ORG_ADDRESS=123 Example Street, City, State 0000
ORG_CHARITY_NUMBER=CC-12345
ORG_EMAIL=receipts@example.org

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Your Gmail address and an App Password (NOT your normal Gmail password)
# How to create an App Password: https://support.google.com/accounts/answer/185833
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
